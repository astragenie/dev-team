{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${PWD}/.claude/hooks/log_event.sh\"; [ -f \"$s\" ] || exit 0; exec \"$s\" session_start",
            "description": "crew:session-start"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${PWD}/.claude/hooks/log_event.sh\"; [ -f \"$s\" ] || exit 0; exec \"$s\" task_created",
            "description": "crew:task-created"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${PWD}/.claude/hooks/log_event.sh\"; [ -f \"$s\" ] || exit 0; exec \"$s\" task_completed",
            "description": "crew:task-completed"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${PWD}/.claude/hooks/log_event.sh\"; [ -f \"$s\" ] || exit 0; exec \"$s\" subagent_start",
            "description": "crew:subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${PWD}/.claude/hooks/log_event.sh\"; [ -f \"$s\" ] || exit 0; exec \"$s\" subagent_stop",
            "description": "crew:subagent-stop"
          },
          {
            "type": "command",
            "command": "s=\"${PWD}/.claude/hooks/subagent_handoff_check.sh\"; [ -f \"$s\" ] || exit 0; exec \"$s\"",
            "description": "crew:handoff-verifier"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${PWD}/.claude/hooks/session_end_checkpoint.sh\"; [ -f \"$s\" ] || exit 0; exec \"$s\"",
            "description": "crew:session-end-checkpoint"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${PWD}/.claude/hooks/check_git_gate.sh\"; [ -f \"$s\" ] || exit 0; exec \"$s\"",
            "description": "crew:git-gate-reminder"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PWD}/hooks/pre-tool-use-agent.ts\"",
            "description": "crew:dispatch-timing-pretap"
          },
          {
            "type": "command",
            "command": "bun \"${PWD}/hooks/pre-tool-use-model-enforce.ts\"",
            "description": "crew:model-routing-enforce"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PWD}/hooks/check-subagent-return.ts\"",
            "description": "crew:check-subagent-return"
          }
        ]
      }
    ]
  }
}
