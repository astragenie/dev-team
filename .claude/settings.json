{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${PWD}/.claude/hooks/log_event.sh session_start",
            "description": "crew:session-start"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PWD}/.claude/hooks/log_event.sh task_created",
            "description": "crew:task-created"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PWD}/.claude/hooks/log_event.sh task_completed",
            "description": "crew:task-completed"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PWD}/.claude/hooks/log_event.sh subagent_start",
            "description": "crew:subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PWD}/.claude/hooks/log_event.sh subagent_stop",
            "description": "crew:subagent-stop"
          },
          {
            "type": "prompt",
            "prompt": "CREW HANDOFF VERIFIER: A subagent just stopped. Check its return message. If this was a crew:builder, crew:reviewer, or crew:researcher dispatched for substantial work (>5 tool calls or multi-file scope), it MUST have written a handoff artifact via write-handoff and returned the artifact path. If the return message does NOT contain a path under .claude/artifacts/crew/handoffs/, the subagent violated the handoff-before-stop contract. Action: (1) note the gap explicitly in your next message to the user, (2) run `git status` to verify working tree state, (3) check .claude/artifacts/crew/handoffs/ for recent files. Quick-lookup agents (Explore, single-grep researchers) are exempt. Do NOT silently continue past a missing handoff on substantial work.",
            "description": "crew:handoff-verifier"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PWD}/.claude/hooks/session_end_checkpoint.sh",
            "description": "crew:session-end-checkpoint"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PWD}/.claude/hooks/check_git_gate.sh",
            "description": "crew:git-gate-reminder"
          }
        ]
      }
    ]
  }
}
