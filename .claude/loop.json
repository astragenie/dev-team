{
  "preset": "typescript-plugin-dev",
  "loop": {
    "aiLoopRoot": "docs/ai-loop",
    "backlogPath": "docs/backlog",
    "backlogRoot": "docs/backlog",
    "slicesRoot": "docs/ai-loop/slices",
    "phaseGateArtifactDir": ".claude/artifacts/crew/validations",
    "maxIterations": 25
  },
  "stack": {
    "build": [
      {
        "cmd": "npm",
        "args": ["test"]
      }
    ],
    "test": [
      {
        "cmd": "npm",
        "args": ["run", "lint"]
      },
      {
        "cmd": "node",
        "args": ["./scripts/validate-manifests.mjs"]
      },
      {
        "cmd": "node",
        "args": ["./scripts/validate-skills.mjs"]
      }
    ],
    "frontendBuild": null,
    "infraPlan": null,
    "aspireBoot": null,
    "healthchecks": []
  },
  "reviewers": {
    "ladder": [
      "A",
      "B"
    ]
  },
  "mandatoryDocs": [
    "docs/architecture/platform-overview.md"
  ],
  "productName": "hero-crew",
  "productDescription": "Claude Code plugin: Crew harness with lead-guided engineering workflow, bounded subagents, quality gates, and inspectable handoffs.",
  "stackDescription": "- ESM / Node.js (node:test, ESLint flat config, Prettier)\n- Content-heavy plugin: agents/, skills/, commands/, hooks/\n- No server, no container — plugin is installed by consumers",
  "github": {
    "enabled": true,
    "repo": null
  }
}
