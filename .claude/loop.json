{
  "schemaVersion": 1,
  "preset": "typescript-plugin-dev",
  "projectType": "claude-plugin",
  "split": false,
  "frontend": {
    "framework": "none",
    "language": "typescript"
  },
  "backend": {
    "framework": "node",
    "language": "typescript",
    "storage": "none"
  },
  "contract": "none",
  "deployment": "none",
  "skills": [
    "typescript-pro",
    "frontend-advisory"
  ],
  "loop": {
    "phaseGateArtifactDir": ".claude/artifacts/crew/validations",
    "slicesRoot": ".claude/artifacts/loop/slices",
    "backlogRoot": ".claude/artifacts/loop/backlog",
    "maxIterations": 25,
    "cost": {
      "ceilingUsd": 75,
      "regression": {
        "multiplier": 3,
        "window": 5,
        "minSamples": 3
      }
    }
  },
  "stack": {
    "build": [
      {
        "cmd": "bun",
        "args": [
          "test",
          "--parallel"
        ]
      }
    ],
    "test": [
      {
        "cmd": "bun",
        "args": [
          "run",
          "lint"
        ]
      },
      {
        "cmd": "node",
        "args": [
          "./scripts/validate-manifests.ts"
        ]
      },
      {
        "cmd": "node",
        "args": [
          "./scripts/validate-skills.ts"
        ]
      }
    ],
    "frontendBuild": null,
    "infraPlan": null,
    "aspireBoot": null,
    "healthchecks": []
  },
  "reviewers": {
    "ladder": [
      "A",
      "B"
    ]
  },
  "mandatoryDocs": [
    "docs/architecture/platform-overview.md"
  ],
  "productName": "hero-crew",
  "productDescription": "Claude Code plugin: Crew harness with lead-guided engineering workflow, bounded subagents, quality gates, and inspectable handoffs.",
  "stackDescription": "- ESM / Node.js (node:test, ESLint flat config, Prettier)\n- Content-heavy plugin: agents/, skills/, commands/, hooks/\n- No server, no container — plugin is installed by consumers",
  "github": {
    "enabled": false,
    "repo": null
  }
}
