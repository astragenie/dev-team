# Copy to .env.local (gitignored) and fill real values. Bun auto-loads .env.local on `bun run evals`.
# Never commit real keys. .env.local is already in .gitignore.

# Groq — live LLM-judge for evals + GEPA (FEAT-192 AC-3, FEAT-183 soak trials).
# Free tier: 30 req/min, model llama-3.3-70b-versatile. Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — second judge provider (FEAT-183 pipeline). Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
